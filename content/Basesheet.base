filters:
  and:
    - note["content type"] == "Article"
views:
  - type: board
    name: Sort by Word Count
    order:
      - file.name
      - content status
      - author
      - wordcount
    sort:
      - property: wordcount
        direction: ASC
  - type: board
    name: Sort by Title
    order:
      - file.name
      - content status
      - author
      - wordcount
    sort:
      - property: file.name
        direction: ASC
